provider aws {
  source  = "hashicorp/aws"
  version = "5.37.0"
  region  = "us-west-2"
}

lookup aws_ami as ubuntu {
  most_recent = true
  filter = {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"]
  }
  owners = ["099720109477"]
}

resource aws_instance as app_server {
  ami           = ubuntu.id
  instance_type = "t2.micro"
  tags = {
    Name = "learn-terraform"
  }
}
