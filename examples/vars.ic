provider aws {
  source  = "hashicorp/aws"
  version = "5.37.0"
  region  = "eu-west-1"
  allowed_account_ids = ["123456789012"]
  assume_role = {
    role_arn = "arn:aws:iam::123456789012:role/deploy"
  }
}

var curr_bucket = {
  name = "my_default_bucket_name"
  envs = ["prod", "local"]
}

resource aws_s3_bucket as my_bucket {
  bucket = curr_bucket.envs[0]
  id = aws.allowed_account_ids[0]
}
