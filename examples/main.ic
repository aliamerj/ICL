provider aws {
  source  = "hashicorp/aws"
  version = "5.37.0"
  region  = "eu-west-1"

  allowed_account_ids = ["123456789012"]

  assume_role = {
    role_arn = "arn:aws:iam::123456789012:role/deploy"
  }
}

provider aws {
  source = "hashicorp/aws"
  version = "5.37.0"
  alias  = "east"
  region = aws.region
}

provider random {
  source  = "hashicorp/random"
  version = "~> 3.0"
}
